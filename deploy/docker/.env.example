# Docker Compose Environment Variables
# Copy to .env and fill in your values

# ===================
# Database
# ===================
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/physical_ai?sslmode=require

# ===================
# Qdrant Vector Database
# ===================
# For production, use Qdrant Cloud
QDRANT_URL=https://xxx.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=physical_ai_book

# For local development with Docker
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# ===================
# OpenAI
# ===================
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4-turbo-preview

# ===================
# CORS
# ===================
CORS_ORIGINS=http://localhost:3000,https://physical-ai-robotics.github.io

# ===================
# Application
# ===================
DEBUG=false
LOG_LEVEL=INFO
