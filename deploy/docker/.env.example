# Docker Compose Environment Variables
# Copy to .env and fill in your values

# ===================
# Database (Neon Serverless Postgres)
# ===================
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/physical_ai?sslmode=require

# ===================
# Cohere Embeddings
# ===================
COHERE_API_KEY=your-cohere-api-key
COHERE_EMBEDDING_MODEL=embed-english-v3.0
COHERE_EMBEDDING_DIMENSION=1024

# ===================
# Qdrant Vector Database
# ===================
# For production, use Qdrant Cloud
QDRANT_URL=https://xxx.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=book_chunks

# For local development with Docker
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# ===================
# OpenAI (Chat Completions)
# ===================
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4-turbo-preview

# ===================
# Document Chunking
# ===================
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ===================
# CORS
# ===================
CORS_ORIGINS=http://localhost:3000,https://hackathon01-lilac.vercel.app

# ===================
# Application
# ===================
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=Physical AI RAG Backend
APP_VERSION=1.0.0
