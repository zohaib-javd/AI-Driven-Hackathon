# ============================================================================
# Physical AI & Humanoid Robotics - Secure RAG Chatbot
# Environment Configuration Template
# ============================================================================
#
# SECURITY NOTICE:
# - Copy this file to .env and fill in your actual values
# - NEVER commit .env to version control
# - All credentials are REQUIRED unless marked as optional
#
# ============================================================================

# ===================
# REQUIRED CREDENTIALS
# ===================
# The backend will REFUSE TO START if any of these are missing

# Cohere API Key (for embeddings)
# Get from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# OpenAI API Key (for chat completions)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Qdrant Cloud URL and API Key (for vector storage)
# Get from: https://cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=

# Neon Postgres Database URL (for metadata storage)
# Get from: https://console.neon.tech
# Format: postgresql+asyncpg://user:pass@host/db?sslmode=require
DATABASE_URL=

# ===================
# OPTIONAL CONFIGURATION
# ===================
# These have sensible defaults and are not required

# Application Settings
APP_NAME=Physical AI RAG Chatbot
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Model Configuration
COHERE_EMBEDDING_MODEL=embed-english-v3.0
COHERE_EMBEDDING_DIMENSION=1024
OPENAI_CHAT_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7

# Vector Store Configuration
QDRANT_COLLECTION_NAME=book_chunks

# RAG Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7
MAX_CONTEXT_LENGTH=4000

# CORS Origins (comma-separated)
# Add your frontend URLs here
CORS_ORIGINS=http://localhost:3000,https://hackathon01-lilac.vercel.app

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Voice Input (Optional Feature)
WHISPER_MODEL=base
ENABLE_VOICE_INPUT=false
