# Environment Configuration Template
# Copy this file to .env and fill in your values

# ===================
# Database Configuration
# ===================
# Neon Serverless Postgres connection string
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# ===================
# Vector Database
# ===================
# Qdrant Cloud or local instance
QDRANT_URL=https://xxx.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=physical_ai_book

# ===================
# OpenAI Configuration
# ===================
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4-turbo-preview

# ===================
# Application Settings
# ===================
APP_NAME=Physical AI RAG Chatbot
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://physical-ai-robotics.github.io

# ===================
# RAG Configuration
# ===================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7

# ===================
# Rate Limiting
# ===================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
